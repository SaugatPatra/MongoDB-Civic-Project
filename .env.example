# Copy to .env (never commit .env). Leave MONGODB_URI empty to run in demo mode.
STORAGE_BACKEND=demo
# demo | mongodb  (blank = auto: mongodb if MONGODB_URI is set)
MONGODB_URI=
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=civicpulse
MONGODB_COLLECTION=reports
